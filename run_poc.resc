$name?="AM64x_RPMsg_POC"

using sysbus
mach create $name
machine LoadPlatformDescription @am64_zynqmp.repl

# Load ZynqMP Linux image
$kernel?=@https://dl.antmicro.com/projects/renode/zynqmp--Image-s17006080-36ba9a2c3a50da83017ce422ddc39d893f664551
$rootfs?=@https://dl.antmicro.com/projects/renode/zynqmp--rootfs.ext2-s6512306-03f1eb9c9b5f1afdb5bb6b490d1f7d242f3da7e4

sysbus LoadELF $kernel
sysbus LoadDiskImage $rootfs 0x0

# Set bootargs to force generic-uio binding
sysbus.cpu0 BootConfigString "console=ttyPS0,115200 root=/dev/ram0 rw earlyprintk uio_pdrv_genirq.of_id=\"generic-uio\""

showAnalyzer uart0
showAnalyzer uart1

macro reset
"""
    # Assuming standard ZynqMP resets
    sysbus.rpu0 IsHalted true
    # Configure PC for RPU if needed
"""

# Note: The userspace application (am64_rpmsg_userspace) must be injected into the rootfs 
# or loaded via virtio prior to execution in the simulation.
